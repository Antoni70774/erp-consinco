{
  "name": "erp-consinco-desktop",
  "version": "1.0.0",
  "description": "App desktop do ERP — conecta ao sistema hospedado na nuvem",
  "main": "main.js",
  "author": "Sua Empresa",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.suaempresa.erpconsinco",
    "productName": "ERP Sistema de Gestão",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "setup.html"],
    "win": { "target": "nsis", "icon": "icon.ico" },
    "mac": { "target": "dmg", "icon": "icon.icns" },
    "linux": { "target": "AppImage", "icon": "icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
